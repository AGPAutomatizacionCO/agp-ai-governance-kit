{
  "version": "1",
  "desarrollo": "demo",
  "fuentes_datos": [
    {
      "database_id": "colombia",
      "server": "agpcolombia.database.windows.net",
      "database": "AGP_Colombia",
      "motor": "Azure SQL",
      "esquemas": [
        {
          "schema": "app_ejemplo_demo",
          "tablas": [
            {
              "table": "App_Ejemplo_Demo_acceso_personas",
              "origen": "propia_del_desarrollo",
              "crear_en_despliegue": true,
              "sensibilidad": "baja",
              "descripcion": "Personas con acceso a la vista y su perfil (configuración local de roles)",
              "operaciones_permitidas": [
                "SELECT",
                "INSERT",
                "UPDATE",
                "DELETE"
              ],
              "columnas": [
                {
                  "name": "Id",
                  "sensible": false,
                  "tipo": "int",
                  "clave_primaria": true,
                  "autoincremental": true
                },
                {
                  "name": "Correo",
                  "sensible": true,
                  "tipo": "nvarchar(256)",
                  "nulable": false,
                  "unico": true
                },
                {
                  "name": "Perfil",
                  "sensible": false,
                  "tipo": "nvarchar(64)",
                  "nulable": false
                }
              ]
            },
            {
              "table": "App_Ejemplo_Demo_acceso_auditoria",
              "origen": "propia_del_desarrollo",
              "crear_en_despliegue": true,
              "sensibilidad": "baja",
              "descripcion": "Auditoría de cambios de perfil y de carga de secretos (solo se inserta)",
              "operaciones_permitidas": [
                "SELECT",
                "INSERT"
              ],
              "columnas": [
                {
                  "name": "Id",
                  "sensible": false,
                  "tipo": "int",
                  "clave_primaria": true,
                  "autoincremental": true
                },
                {
                  "name": "Fecha",
                  "sensible": false,
                  "tipo": "datetime2",
                  "nulable": false,
                  "valor_por_defecto": "SYSUTCDATETIME()"
                },
                {
                  "name": "Actor",
                  "sensible": true,
                  "tipo": "nvarchar(256)",
                  "nulable": false
                },
                {
                  "name": "Destinatario",
                  "sensible": true,
                  "tipo": "nvarchar(256)",
                  "nulable": false
                },
                {
                  "name": "PerfilAnterior",
                  "sensible": false,
                  "tipo": "nvarchar(64)",
                  "nulable": true
                },
                {
                  "name": "PerfilNuevo",
                  "sensible": false,
                  "tipo": "nvarchar(64)",
                  "nulable": true
                },
                {
                  "name": "Resultado",
                  "sensible": false,
                  "tipo": "nvarchar(32)",
                  "nulable": false
                }
              ]
            }
          ]
        },
        {
          "schema": "corporacion",
          "tablas": [
            {
              "table": "vw_UsuariosCorporacion",
              "origen": "preexistente",
              "sensibilidad": "media",
              "descripcion": "Directorio corporativo de IT para buscar personas al asignar un perfil (solo lectura)",
              "operaciones_permitidas": [
                "SELECT"
              ],
              "columnas": [
                {
                  "name": "Correo",
                  "sensible": true,
                  "tipo": "nvarchar(256)"
                },
                {
                  "name": "Nombre",
                  "sensible": true,
                  "tipo": "nvarchar(256)"
                },
                {
                  "name": "Area",
                  "sensible": false,
                  "tipo": "nvarchar(128)"
                },
                {
                  "name": "Cargo",
                  "sensible": false,
                  "tipo": "nvarchar(128)"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
