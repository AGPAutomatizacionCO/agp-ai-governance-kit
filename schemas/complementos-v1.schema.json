{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:governance:complementos:1",
  "title": "Complementos externos de un desarrollo AGP (.agp/complementos.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "complementos"],
  "properties": {
    "apiVersion": { "const": "complementos.agp/v1" },
    "complementos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tipo", "nombre", "descripcion", "carpeta", "operador", "dondeCorre", "requisitos", "conexiones", "secretos", "configuracion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
          "tipo": { "enum": ["ejecutor-escritorio"] },
          "nombre": { "type": "string", "minLength": 3, "maxLength": 80 },
          "descripcion": { "type": "string", "minLength": 10, "maxLength": 300 },
          "carpeta": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" },
          "operador": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
          "respaldo": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$" },
          "dondeCorre": { "type": "string", "minLength": 5, "maxLength": 200 },
          "requisitos": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3, "maxLength": 200 } },
          "conexiones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["con", "como"],
              "properties": {
                "con": { "enum": ["portal", "rabbitmq", "sap", "otro"] },
                "como": { "type": "string", "minLength": 3, "maxLength": 200 },
                "colas": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9._-]{1,100}$" } }
              }
            }
          },
          "secretos": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variable", "secreto"],
              "properties": {
                "variable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
                "secreto": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,126}$" }
              }
            }
          },
          "configuracion": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" }
        }
      }
    }
  }
}
