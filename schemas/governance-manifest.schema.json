{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agp:governance:manifest:1",
  "title": "Referencia de gobierno de un desarrollo AGP",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kit", "profile"],
  "properties": {
    "apiVersion": { "const": "governance.agp/v1" },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "version", "ref"],
      "properties": {
        "source": { "const": "AGPAutomatizacionCO/agp-ai-governance-kit" },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[1-9][0-9]*)?$"
        },
        "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
